// 072 Configuracao Prisma Principal.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // file:./data.db cria sozinho
  url      = env("DATABASE_URL")
}

model FilePointer {
  id        String   @id @default(cuid())
  name      String
  // BigInt para ponteiros TB - nao cabe em Int
  size      BigInt   // bytes, pode ser TB = 1_000_000_000_000n
  pointer   BigInt?  // offset no bucket
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket])
  @@map("files")
}

model Job {
  id        String   @id
  status    String   // pending | processing | completed | failed
  payload   Json?
  createdAt DateTime @default(now())

  @@index([status])
  @@map("jobs")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql" // sqlite, mysql, postgresql
  url      = env("DATABASE_URL")
}

// V6 - Site como tabela, tudo guardado no site
model Site {
  id        String   @id @default(cuid())
  slug      String   @unique
  data      Json     @default("{}") // paginas, cms, config = jsonb
  version   Int      @default(1)
  files     File[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  filename   String
  mimetype   String
  size       BigInt   // BIGINT para >2GB, ponteiro para TB
  storageKey String?  @db.Text // pointer para S3/R2/HF/Kaggle/Terabox/NPM CDN
  hash       String?
  metadata   Json     @default("{}") // manifesto
  chunks     FileChunk[]
  storageUrl String? // R2/Supabase URL hibrido
}

model FileChunk {
  id      String @id @default(cuid())
  fileId  String
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  idx     Int
  data    Bytes  // 1MB por chunk seguro em qualquer provider
  @@unique([fileId, idx])
}

// Runner de computação - transforma file storage em compute
model ComputeJob {
  id        String   @id @default(cuid())
  siteId    String
  fileId    String?
  status    String   @default("queued") // queued, running, done, failed
  runner    String?  // github, forgejo, codeberg, gitlab, huggingface
  resultUrl String?  @db.Text
  logs      String?  @db.Text
  createdAt DateTime @default(now())
}
