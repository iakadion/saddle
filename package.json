{
  "name": "@devthink/saddle",
  "version": "0.2.0",
  "description": "binary computing engine that turns distributed storage into a publishable working set",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/iakadion/saddle.git" },
  "bugs": { "url": "https://github.com/iakadion/saddle/issues" },
  "homepage": "https://github.com/iakadion/saddle#readme",
  "keywords": ["distributed computing", "virtual memory", "runner", "storage", "automation"],
  "engines": { "node": ">=22" },
  "bin": { "saddle": "./cli/main.js" },
  "exports": {
    ".": "./index.js",
    "./memory": "./memory/bridge.js",
    "./memory-engine": "./memory/engine.js",
    "./storage": "./storage/adapter.js",
    "./runners": "./runners/scheduler.js",
    "./sessions": "./domain/sessions.js",
    "./modes": "./memory/modes.js",
    "./browser": "./browser/agent.js",
    "./bot": "./bot/bot.js",
    "./captcha": "./captcha/contract.js",
    "./deploy": "./deploy/index.js"
  },
  "files": ["core", "domain", "memory", "runners", "runtime", "storage", "sessions", "modes", "adapters", "persistence", "queue", "dispatch", "scrape", "crawl", "api", "mcp", "browser", "proxy", "captcha", "ai", "webhook", "surfaces", "library", "errors", "retry", "server", "packager", "bot", "protocol", "workflow", "cli", "index.js", "docs", "examples", "README.md", "LICENSE"],
  "scripts": {
    "check": "node --check index.js && node --check runtime/engine.js && node --check cli/main.js",
    "test": "node --test tests/*.test.js",
    "run": "node cli/main.js",
    "pack:check": "npm run check && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run pack:check"
  }
}
