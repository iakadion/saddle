    "node": ">=26.7.0",
    "npm": ">=10.9.2"
  },
  "peerDependencies": {
    "playwright": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "bin": {
    "saddle": "./cli/main.js"
  },
  "exports": {
    ".": "./index.js",
    "./memory": "./memory/bridge.js",
    "./memory-node": "./memory/bridge.js",
