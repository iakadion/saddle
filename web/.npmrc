



# Ignora restrições de versão do Node (resolve o erro EBADENGINE do auth0)
engine-strict=false
cache-integrity=true

# Sempre prefere a versão mais recente disponível online
prefer-online=true
fetch-retries=5
cache-min=0

# Configuração para salvar versões com "^" (permite atualizações automáticas minor/patch)
save-exact=false
save-prefix=^

# Resolve conflitos de peer dependencies (evita erros de "ERESOLVE")
legacy-peer-deps=true
auto-install-peers=true
strict-peer-deps=false
force=true

# Otimizações de instalação
prefer-dedupe=true

# Oculta avisos de doação e auditoria (limpa o terminal)
fund=false
audit=false

# Nível de log (warn esconde mensagens de "notice", mas mostra avisos importantes)
loglevel=error

# Isso ajuda a evitar o erro "The from argument must be of type string" em versões bleeding-edge
install-links=false

# Ignora scripts do ciclo de vida (postinstall, preinstall, etc) durante npm install
ignore-scripts=true
no-optional=true