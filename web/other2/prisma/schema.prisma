// devthink ai gateway - prisma schema for prisma 7 with driver adapter
// the datasource url is provided by prisma.config.ts and the adapter in db.ts
// 7 models with essential fields for the gateway

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// every interaction log across v1 zai, v2 babel town, v3 nvidia
model chatmessage {
  id                  String @id @default(cuid())
  active              Boolean @default(true)
  allparams           String?
  allresponse         String?
  annotations         String?
  autofixapplied      String?
  cachedtokens        Int @default(0)
  chattemplatekwargs  String?
  completedat         DateTime?
  completion          String?
  completiontokens    Int?
  content             String @default("")
  contextshared       Boolean @default(false)
  devthinkcontext     Int?
  devthinkoutput      Int?
  endpoint            String?
  error               String?
  errorcode           String?
  errormessage        String?
  finishreason        String?
  firsttokenms        Int @default(0)
  frequencypenalty    Float?
  httpstatus          Int?
  inputtokens         Int @default(0)
  ip                  String @default("unknown")
  ipused              String @default("unknown")
  keyid               String?
  keylabel            String?
  latencyms           Int @default(0)
  lastused            DateTime?
  logprobs            String?
  maxtokens           Int?
  messagenumber       Int?
  model               String?
  modelvariant        String?
  objectid            String?
  outputtokens        Int @default(0)
  presencepenalty     Float?
  prompttokens        Int @default(0)
  provider            String?
  reasoningcontent    String?
  reasoningeffort     String?
  reasoninglevel      String?
  requestid           String?
  responseid          String?
  responseheaders     String?
  retries             Int @default(0)
  role                String @default("assistant")
  rotationcount       Int @default(0)
  rotationindex       Int?
  route               String?
  seed                Int?
  servicetier         String?
  sessionid           String?
  sources             String?
  startedat           DateTime?
  status              String @default("active")
  stop                String?
  stopsequence        String?
  stream              Boolean @default(false)
  streammode          Boolean @default(false)
  systemfingerprint   String?
  temperature         Float?
  thinking            String?
  thinkingbudget      Int?
  thinkingenabled     Boolean @default(true)
  thinkinglevel       String?
  thinkingtokens      Int @default(0)
  toolcalls           String?
  topk                Int?
  topp                Float?
  totaltokens         Int @default(0)
  useragent           String?
  useragentforged     String?
  createdat           DateTime @default(now())
  updatedat           DateTime @updatedAt

  @@index([sessionid])
  @@index([route])
  @@index([model])
  @@index([provider])
  @@index([status])
  @@index([createdat])
}

/// nvidia api key management with rotation
model nvidiakey {
  id                  String @id @default(cuid())
  keyvalue            String @unique
  label               String?
  active              Boolean @default(true)
  status              String @default("active")
  provider            String @default("nvidia")
  usecount            Int @default(0)
  rotationcount       Int @default(0)
  errorcount          Int @default(0)
  lastusedat          DateTime?
  lasterrormessage    String?
  keytier             String?
  keyquota            Int?
  keyrpm              Int?
  keytpm              Int?
  keymaxtokens        Int?
  keycontextwindow    Int?
  keysupportsstreaming Boolean?
  keysupportsthinking  Boolean?
  keyregion           String?
  keypriority         Int?
  keyhealth           String?
  keyhealthscore      Float?
  createdat           DateTime @default(now())
  updatedat           DateTime @updatedAt

  @@index([active])
  @@index([status])
  @@index([provider])
}

/// babel town key management with session and expiry
model townkey {
  id                String @id @default(cuid())
  keyvalue          String @unique
  label             String?
  active            Boolean @default(true)
  status            String @default("active")
  provider          String @default("babeltown")
  usecount          Int @default(0)
  rotationcount     Int @default(0)
  errorcount        Int @default(0)
  lastusedat        DateTime?
  lasterrormessage  String?
  sessionid         String?
  useragentforged   String?
  ipforged          String?
  expiresat         DateTime?
  keytier           String?
  keyquota          Int?
  keyrpm            Int?
  keytpm            Int?
  keyregion         String?
  keyhealth         String?
  createdat         DateTime @default(now())
  updatedat         DateTime @updatedAt

  @@index([active])
  @@index([status])
  @@index([expiresat])
}

/// shared context for devthink meta-model across requests
/// session isolation: each (sessionid, provider) pair is unique so
/// v1/zai, v2/babeltown and v3/nvidia never share rotation state.
model sessioncontext {
  id              String @id @default(cuid())
  sessionid       String
  provider        String  @default("zai")
  route           String?
  model           String?
  modelvariant    String?
  inputsummary    String?
  outputsummary   String?
  thinkingsummary String?
  messagecount    Int @default(0)
  lastmessageat   DateTime?
  contextwindow   Int?
  rotationindex   Int @default(0)
  thinkinglevel   String?
  thinkingbudget  Int?
  thinkingenabled Boolean @default(true)
  createdat       DateTime @default(now())
  updatedat       DateTime @updatedAt

  @@unique([sessionid, provider])
  @@index([provider])
  @@index([route])
  @@index([lastmessageat])
}

/// deployment logs for the gateway
model deploylog {
  id            String @id @default(cuid())
  version       String?
  status        String @default("pending")
  startedat     DateTime?
  completedat   DateTime?
  error         String?
  durationms    Int?
  commit        String?
  environment   String?
  buildsteps    String?
  healthcheck   String?
  rollback      Boolean @default(false)
  createdat     DateTime @default(now())
  updatedat     DateTime @updatedAt

  @@index([status])
  @@index([createdat])
}

/// user table
model user {
  id        String @id @default(cuid())
  email     String?
  name      String?
  role      String @default("user")
  active    Boolean @default(true)
  createdat DateTime @default(now())
  updatedat DateTime @updatedAt

  @@index([email])
  @@index([active])
}

/// post table
model post {
  id        String @id @default(cuid())
  title     String?
  content   String?
  userid    String?
  active    Boolean @default(true)
  createdat DateTime @default(now())
  updatedat DateTime @updatedAt

  @@index([userid])
  @@index([active])
}
