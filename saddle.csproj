<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Saddle</PackageId>
    <Version>1.0.0</Version>
    <Authors>devthink</Authors>
    <Description>Binary computing engine that turns distributed storage into a publishable working set.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/iakadion/saddle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>distributed-computing;virtual-memory;automation</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
</Project>
